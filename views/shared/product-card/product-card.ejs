<% const colorPhotos=product.colorImages||[],variants=(product.variants||[]).filter(v=>v.isActive!==false),sizes=[...new Set(variants.map(v=>v.size))],colors=[...new Set(variants.map(v=>v.color).filter(Boolean))].map(color=>({color,code:(typeof catalogColorCodes!=='undefined'&&catalogColorCodes[color])||variants.find(v=>v.color===color)?.colorCode||({'قرمز':'#E53935','آبی':'#1976D2','سبز':'#388E3C','مشکی':'#000000','سفید':'#FFFFFF','سرمه‌ای':'#001F54','سرمه ای':'#001F54','سورمه ای':'#001F54','زرد':'#FDD835','صورتی':'#F48FB1','طوسی':'#9E9E9E','نارنجی':'#FB8C00','بنفش':'#8E24AA','کرم':'#FFF1D6','قهوه‌ای':'#795548'}[color])||'',images:colorPhotos.find(g=>g.color===color)?.images||[]})),cover=product.coverImage||product.image,second=colors[0]?.images?.[1]||product.images?.find(i=>i!==cover)||cover; %>
<article class="product-card"><div class="product-card__visual"><a href="<%= product.url %>" class="product-card__image-link"><img class="card-cover" src="<%= cover %>" alt="<%= product.title %>" loading="lazy" width="600" height="600"><img class="card-secondary" src="<%= second %>" alt="" loading="lazy" width="600" height="600"></a><% if(product.discount>0){ %><span class="product-card__badge sale-badge"><%= product.discount.toLocaleString('fa-IR') %>٪</span><% }else if(product.badge){ %><span class="product-card__badge"><%= product.badge %></span><% } %><% if(product.itemType==='Product'){ %><button class="product-card__heart" type="button" data-wishlist="<%= product.id %>" aria-pressed="<%= wishlistIds.includes(String(product.id)) %>" aria-label="علاقه‌مندی: <%= product.title %>"><%- include('../icons/icon',{name:'heart'}) %></button><% } %></div><div class="product-card__body"><h3><a href="<%= product.url %>"><%= product.title %></a></h3><div class="card-variants"><div class="card-sizes" aria-label="سایزها"><% sizes.forEach(s=>{ %><span><%= s %></span><% }) %></div><div class="card-colors" aria-label="رنگ‌ها"><% colors.forEach(c=>{ %><a href="<%= product.url %>?color=<%= encodeURIComponent(c.color) %>" <% if(c.images.length){ %>data-color-preview="<%= c.images[0] %>"<% } %> aria-label="رنگ <%= c.color %>" title="<%= c.color %>"><% if(/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(c.code.trim())){ %><span class="card-color-swatch" style="--swatch:<%= c.code %>" aria-hidden="true"></span><% }else{ %><span class="card-color-swatch card-color-unknown" aria-hidden="true"></span><% } %><% if(c.images.length){ %><img src="<%= c.images[0] %>" alt="" width="42" height="42" loading="lazy"><% } %></a><% }) %></div></div><div class="product-card__bottom"><div><% if(product.discount>0){ %><del><%= money(product.originalPrice) %></del><% } %><strong class="price"><%= variants.length>1?'از ':'' %><%= money(product.price) %></strong></div><a class="product-card__buy" href="<%= product.url %>" aria-label="انتخاب و خرید <%= product.title %>"><%- include('../icons/icon',{name:'bagPlus'}) %></a></div><% if(product.stock<1){ %><small>ناموجود</small><% } %></div></article>