<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/journal.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="container journal"><header class="journal-heading"><span class="eyebrow">PAWEAR JOURNAL</span><h1>جزئیات کوچک، انتخاب‌های بهتر.</h1><p>راهنمای جوراب، مراقبت و سبک زندگی؛ از مجلهٔ پاور.</p></header><form class="journal-search"><input type="search" name="q" value="<%= q %>" placeholder="جست‌وجو در مقاله‌ها" aria-label="جست‌وجوی مقاله"><select name="category" aria-label="دسته‌بندی"><option value="">همه موضوع‌ها</option><% categories.forEach(c=>{ %><option <%= c===category?'selected':'' %>><%= c %></option><% }) %></select><button class="btn btn--primary">جست‌وجو</button></form><div class="journal-grid"><% articles.forEach(a=>{ %><article class="journal-card"><a href="/journal/<%= a.slug %>"><img src="<%= a.cover %>" alt="<%= a.coverAlt %>" width="640" height="360" loading="lazy"><div><span><%= a.category %></span><h2><%= a.title %></h2><p><%= a.excerpt %></p><b>خواندن مقاله ←</b></div></a></article><% }) %></div><% if(!articles.length){ %><p>مقاله‌ای با این جست‌وجو پیدا نشد.</p><% } %><nav class="journal-pagination"><% if(page>1){ %><a href="?page=<%= page-1 %>&q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(category) %>">صفحه قبل</a><% } %><span><%= page.toLocaleString('fa-IR') %></span><% if(page*9<total){ %><a href="?page=<%= page+1 %>&q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(category) %>">صفحه بعد</a><% } %></nav></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script></body></html>