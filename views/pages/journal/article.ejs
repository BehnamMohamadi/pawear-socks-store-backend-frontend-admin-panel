<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/journal.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="container journal"><nav class="breadcrumb"><a href="/journal">مجلهٔ پاور</a><span>/</span><span><%= article.category %></span></nav><header class="journal-heading"><span class="eyebrow"><%= article.category %> · <%= minutes.toLocaleString('fa-IR') %> دقیقه مطالعه</span><h1><%= article.title %></h1><p><%= article.excerpt %></p><small>تحریریهٔ پاور · <%= date(article.publishedAt||article.updatedAt) %><%= article.status==='draft'?' · پیش‌نویس':'' %></small></header><img class="journal-cover" src="<%= article.cover %>" alt="<%= article.coverAlt %>" width="1600" height="900" fetchpriority="high"><div class="journal-layout"><aside class="journal-toc"><h2>در این مقاله</h2><% article.blocks.forEach((b,i)=>{if(b.type==='heading'){ %><a href="#section-<%= i %>"><%= b.text %></a><% }}) %></aside><article class="journal-content"><% article.blocks.forEach((b,i)=>{ %><% if(b.type==='heading'){ %><h2 id="section-<%= i %>"><%= b.text %></h2><% }else if(b.type==='paragraph'){ %><p><%= b.text %></p><% }else if(b.type==='list'){ %><ul><% b.text.split('\n').filter(Boolean).forEach(line=>{ %><li><%= line %></li><% }) %></ul><% }else if(b.type==='quote'){ %><blockquote><%= b.text %></blockquote><% }else if(b.type==='image'){ %><figure><img src="<%= b.image %>" alt="<%= b.alt %>" loading="lazy"><figcaption><%= b.caption %></figcaption></figure><% }else if(b.type==='product'){ %><a class="journal-product" href="<%= b.url %>"><%= b.text %> ←</a><% } %><% }) %><% if(article.sources.length){ %><section class="journal-sources"><h2>منابع و مطالعهٔ بیشتر</h2><% article.sources.forEach(s=>{ %><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.title %> ↗</a><% }) %></section><% } %></article></div><% if(related.length){ %><h2>بیشتر بخوان</h2><div class="journal-grid"><% related.forEach(a=>{ %><a class="journal-card" href="/journal/<%= a.slug %>"><img src="<%= a.cover %>" alt="<%= a.coverAlt %>" loading="lazy" width="640" height="360"><h3><%= a.title %></h3></a><% }) %></div><% } %></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script></body></html>