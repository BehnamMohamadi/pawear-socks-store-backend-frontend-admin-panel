<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:'articles',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'چیدمان مقاله را قالب مدیریت می‌کند؛ روی محتوا تمرکز کنید.'}) %><form id="articleForm" class="panel paw-admin-form" data-article='<%= JSON.stringify(article) %>'><label>عنوان<input name="title" value="<%= article.title %>" required maxlength="150"></label><label>آدرس مقاله<input name="slug" value="<%= article.slug %>" maxlength="160"></label><label>دسته‌بندی<input name="category" value="<%= article.category %>" maxlength="60"></label><label>وضعیت<select name="status"><option value="draft">پیش‌نویس</option><option value="published" <%= article.status==='published'?'selected':'' %>>انتشار</option></select></label><label class="paw-full">خلاصه<textarea name="excerpt" maxlength="350"><%= article.excerpt %></textarea></label><section class="paw-full article-cover"><h2>کاور ۱۶:۹</h2><p>پیشنهاد ۱۶۰۰×۹۰۰؛ حداکثر ۵ مگابایت. می‌توانید برش تصویر را پیش از آپلود تنظیم کنید.</p><img id="coverPreview" src="<%= article.cover||'/images/product-placeholder.svg' %>" width="320" height="180" alt="پیش‌نمایش کاور"><input type="file" accept="image/jpeg,image/png,image/webp" data-cover-upload><input name="cover" type="hidden" value="<%= article.cover %>"><label>توضیح عکس<input name="coverAlt" value="<%= article.coverAlt %>" maxlength="250"></label></section><section class="paw-full"><h2>بخش‌های مقاله</h2><div id="articleBlocks"></div><div class="paw-toolbar"><select id="blockType"><option value="paragraph">پاراگراف</option><option value="heading">تیتر</option><option value="list">فهرست</option><option value="quote">نکته برجسته</option><option value="image">عکس</option><option value="product">لینک محصول</option></select><button type="button" class="btn btn-secondary" id="addBlock">افزودن بخش</button></div></section><label class="paw-full">منابع · هر خط: عنوان | آدرس HTTPS<textarea name="sources" rows="3"><%= (article.sources||[]).map(s=>s.title+' | '+s.url).join('\n') %></textarea></label><div class="paw-full paw-toolbar"><button class="btn btn-primary" type="submit">ذخیره مقاله</button><button type="button" class="btn btn-secondary" data-preview-width="100%">پیش‌نمایش دسکتاپ</button><button type="button" class="btn btn-secondary" data-preview-width="375px">پیش‌نمایش موبایل</button><a href="/admin/articles">بازگشت</a><span id="articleStatus" role="status"></span></div></form><section id="articlePreview" hidden class="panel"><iframe title="پیش‌نمایش مقاله" sandbox="allow-same-origin" style="width:100%;height:700px;border:0"></iframe></section><dialog id="blogCrop" class="crop-dialog"><h3>تنظیم برش کاور</h3><canvas width="1600" height="900"></canvas><label>بزرگ‌نمایی<input type="range" min="1" max="3" step=".01" value="1"></label><label>افقی<input type="range" min="0" max="100" value="50"></label><label>عمودی<input type="range" min="0" max="100" value="50"></label><button type="button" class="btn btn-primary" data-crop-ok>تأیید</button><button type="button" class="btn btn-secondary" data-crop-close>انصراف</button></dialog></main></div><%- include('../partials/scripts') %><script src="/js/admin/article-editor.js" defer></script></body></html>