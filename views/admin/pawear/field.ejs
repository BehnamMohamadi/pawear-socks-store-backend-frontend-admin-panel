<% const value=f.name==='brandId'?(record.brandId?._id||record.brandId):record[f.name]; %><label><span><%= f.label %><%= f.required?' *':'' %></span><%if(key==='colors'&&f.name==='code'){%><span class="admin-color-input"><input type="color" data-color-picker aria-label="انتخاب از طیف رنگ" value="<%= /^#[0-9a-f]{6}$/i.test(value||'')?value:'#000000' %>"><input name="code" type="text" dir="ltr" maxlength="7" placeholder="#000000" value="<%= value||'' %>" pattern="#[0-9A-Fa-f]{6}" aria-label="کد رنگ HEX"></span><small>روی نمونه‌رنگ بزنید؛ کد HEX خودکار پر می‌شود.</small><%}else if(f.type==='textarea'){%><textarea name="<%= f.name %>" rows="5"><%= value||'' %></textarea><%}else if(['select','category','subcategory','brand'].includes(f.type)){const options=f.type==='category'?categories.map(c=>[String(c._id),c.name,c]):f.type==='subcategory'?subcategories.map(c=>[String(c._id),c.name,c]):f.type==='brand'?brands.map(b=>[String(b._id),b.name,b]):Object.entries(f.options);%><select name="<%= f.name %>" <%= f.required?'required':'' %>><%if(f.type!=='select'){%><option value="">انتخاب کنید</option><%}%><%options.forEach(([id,label,obj])=>{%><option value="<%= id %>" <%= String(value||'')===id?'selected':'' %> <%= obj?.category?'data-category='+obj.category:'' %>><%= label %><%= obj?.isActive===false?' (غیرفعال)':'' %></option><%})%></select><%}else if(f.type==='checkbox'){%><input name="<%= f.name %>" type="checkbox" role="switch" class="admin-green-switch" <%= value?'checked':'' %>><%}else{%><input name="<%= f.name %>" type="<%= f.type %>" value="<%= f.type==='datetime-local'&&value?new Date(new Date(value).getTime()-new Date(value).getTimezoneOffset()*60000).toISOString().slice(0,16):(value??'') %>" <%= f.required?'required':'' %> <%= f.min!==undefined?'min='+f.min:'' %> <%= f.max!==undefined?'max='+f.max:'' %>><%}%></label>