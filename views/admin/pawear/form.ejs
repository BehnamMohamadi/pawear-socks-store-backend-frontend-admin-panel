<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><div class="paw-toolbar"><a href="/admin/<%= key %>">← بازگشت به فهرست</a><% if(key==='colors'&&record._id){ %><a class="btn btn-secondary" href="/admin/colors/new">+ افزودن رنگ جدید</a><% } %></div><section class="panel"><form id="resourceForm" class="paw-admin-form" data-resource="<%= key %>" data-api="<%= config.api %>" data-id="<%= record._id||'' %>"><% if(key==='products'||key==='boxes'){ const sections=key==='boxes'?[['اطلاعات باکس',['name','slug','sku','description','isActive','isFeatured']],['تخفیف باکس',['discount']]]:[['اطلاعات اصلی محصول',['name','sku','slug','category','subCategory','brandId','gender','isActive','isFeatured']],['قیمت و زمان‌بندی تخفیف',['price','discountEnabled','discount','discountStart','discountEnd']],['توضیحات محصول',['description']]];sections.forEach(([heading,names])=>{ %><section class="product-form-section paw-full"><h2><%= heading %></h2><div class="product-field-grid"><% config.fields.filter(f=>names.includes(f.name)).forEach(f=>{ %><%- include('./field',{f,record,key,categories,subcategories,brands}) %><% }) %></div></section><% }); }else{ config.fields.forEach(f=>{ %><%- include('./field',{f,record,key,categories,subcategories,brands}) %><% }); } %><%if(key==='colors'){%><section class="paw-full color-presets"><h2>رنگ‌های آماده</h2><p>با انتخاب هر رنگ، نام و کد آن پر می‌شود؛ برای ثبت، دکمه ذخیره را بزنید.</p><div data-color-presets></div></section><%}%><%if(key==='products'){%><%- include('./variant-editor',{record,sizeOptions,colorOptions}) %><%- include('./color-media',{record}) %><div class="paw-full product-form-section"><h2>مشخصات تکمیلی</h2><div id="detailRows"><%(record.details||[]).forEach(d=>{%><div class="paw-detail-row"><input data-detail-title value="<%= d.title %>" placeholder="عنوان"><input data-detail-value value="<%= d.value %>" placeholder="مقدار"><button type="button" data-remove-row>حذف</button></div><%})%></div><button type="button" id="addDetail" class="btn btn-secondary">+ مشخصه</button></div><%}%><%if(key==='boxes'){%><%- include('./box-picker',{products,record,money,categories,subcategories,brands}) %><% if(!record._id){ %><section class="product-form-section paw-full"><h2>تصاویر باکس</h2><p>ابتدا اطلاعات و ترکیب باکس را ذخیره کنید؛ سپس در همین صفحه عکس‌ها را آپلود و کاور را انتخاب کنید.</p></section><% } %><%}%><div class="paw-full"><div id="validationDetails" class="admin-validation-box" hidden></div><button type="submit" class="btn btn-primary"><%= key==='colors'?(record._id?'ذخیره تغییرات رنگ':'ثبت رنگ جدید'):'ذخیره' %></button> <span id="formMessage"></span></div></form></section><%if(record._id&&key==='boxes'){%><%- include('./box-media',{record}) %><%}%></main></div><% if(key==='categories'&&record._id&&record.isActive){ %><div class="admin-modal" id="categoryDeactivateModal" hidden aria-hidden="true"><div class="admin-modal__backdrop" data-category-modal-close></div><section class="admin-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="categoryDeactivateTitle"><div class="admin-modal__head"><div><span class="ops-eyebrow">غیرفعال‌سازی وابستگی‌ها</span><h2 id="categoryDeactivateTitle">با غیرفعال شدن این دسته چه چیزهایی غیرفعال شوند؟</h2></div><button type="button" class="admin-modal__close" data-category-modal-close>×</button></div><p>هیچ چیزی خودکار غیرفعال نمی‌شود. موارد موردنظر را خودت انتخاب کن.</p><div class="admin-modal__columns"><section><div class="admin-modal__section-head"><h3>زیردسته‌ها</h3><label><input type="checkbox" data-select-all-subs> انتخاب همه</label></div><div id="categoryModalSubcategories" class="admin-check-list"></div></section><section><div class="admin-modal__section-head"><h3>محصولات</h3><label><input type="checkbox" data-select-all-products> انتخاب همه</label></div><div id="categoryModalProducts" class="admin-check-list"></div></section></div><div class="admin-modal__actions"><button type="button" class="btn btn-secondary" data-category-modal-close>انصراف</button><button type="button" class="btn btn-primary" id="confirmCategoryDeactivate">غیرفعال‌سازی موارد انتخاب‌شده</button></div></section></div><% } %><%- include('../partials/scripts') %><% if(key==='boxes'){ %><script src="/js/admin/box-picker.js" defer></script><script src="/js/admin/box-form.js" defer></script><script src="/js/admin/box-media.js" defer></script><% } %><script src="/js/admin/pawear.js" defer></script><% if(key==='colors'){ %><script src="/js/admin/color-picker.js" defer></script><% } %><% if(key==='products'){ %><script src="/js/admin/color-media.js" defer></script><script src="/js/admin/product-calendar.js" defer></script><% } %></body></html>
