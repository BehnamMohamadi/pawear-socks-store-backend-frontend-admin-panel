<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:'articles',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'محتوای مفید، قابل ویرایش و منظم'}) %><a class="btn btn-primary" href="/admin/articles/new">نوشتن مقاله</a><section class="panel table-wrap"><table><thead><tr><th>عنوان</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead><tbody><% articles.forEach(a=>{ %><tr><td><%= a.title %></td><td><%= a.status==='published'?'منتشرشده':'غیرفعال / پیش‌نویس' %></td><td><%= date(a.updatedAt) %></td><td><a class="btn btn-secondary" href="/admin/articles/<%= a._id %>/edit">ویرایش</a><% if(a.status==='published'){ %> <button type="button" class="btn btn-secondary" data-article-action="deactivate" data-id="<%= a._id %>">غیرفعال کردن</button><% } %> <button type="button" class="btn btn-secondary" data-article-action="delete" data-id="<%= a._id %>">حذف مقاله</button></td></tr><% }) %></tbody></table><% if(!articles.length){ %><p>هنوز مقاله‌ای ثبت نشده است.</p><% } %></section></main></div><%- include('../partials/scripts') %><p role="status" id="articleActionStatus"></p><script src="/js/admin/article-actions.js" defer></script></body></html>